{
  "name": "poe-link-collection",
  "version": "1.0.0",
  "description": "Path of Exile themed link collection hub page",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:fix-html",
    "build:fix-html": "node -e \"const fs = require('fs'); if (fs.existsSync('dist/src/index.html')) { fs.renameSync('dist/src/index.html', 'dist/index.html'); fs.rmdirSync('dist/src'); }\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,html,css}\" \"tests/**/*.js\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/weo-soft/poe-link-collection.git"
  },
  "bugs": {
    "url": "https://github.com/weo-soft/poe-link-collection/issues"
  },
  "homepage": "https://github.com/weo-soft/poe-link-collection#readme",
  "keywords": [
    "path-of-exile",
    "poe",
    "link-collection",
    "hub"
  ],
  "author": "weo-soft",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3"
  }
}
